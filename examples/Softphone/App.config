<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="sipsoftphone" type="SIPSorcery.SoftPhone.SIPSoftPhoneState, softphone"/>
  </configSections>
  <appSettings>
    <add key="STUNServerHostname" value=""/>
    <add key="SIPUsername" value="1010"/>
    <add key="SIPPassword" value="0000"/>
    <add key="SIPServer" value="192.168.12.36"/>
    <add key="SIPFromName" value="Kerem"/>
    <add key="DnsServer" value=""/>
    <add key="UseAudioScope" value="false"/>
    <add key="AudioInDeviceIndex" value="-1"/>
    <add key="AudioOutDeviceIndex" value="-1"/>
    <add key="VideoDeviceName" value=""/>
    <add key="VirtualBackgroundMode" value="None"/>
    <add key="VirtualBackgroundBlurRadius" value="8"/>
    <add key="VirtualBackgroundMaskReuseFrameCount" value="1"/>
    <add key="VirtualBackgroundSegmentationModelPath" value=""/>
    <add key="VirtualBackgroundBackgroundImagePath" value=""/>
    <add key="VirtualBackgroundEnablePerformanceFallback" value="true"/>
    <add key="VirtualBackgroundPerformanceBudgetMilliseconds" value="40"/>
    <add key="VirtualBackgroundPerformanceFallbackFrameCount" value="5"/>
    <add key="VirtualBackgroundMaskSmoothingRadius" value="1"/>
    <add key="VirtualBackgroundMaskSmoothingIterations" value="1"/>
    <add key="VirtualBackgroundMaskFeather" value="0.35"/>
    <add key="VirtualBackgroundMaskForegroundClamp" value="0.92"/>
    <add key="VirtualBackgroundMaskForegroundExponent" value="0.7"/>
    <add key="VirtualBackgroundMaskForegroundBias" value="0"/>
    <add key="VirtualBackgroundSegmentationScale" value="0.3"/>
    <add key="VirtualBackgroundEffectProcessingScale" value="1"/>
    <add key="VirtualBackgroundEnableAdaptiveSegmentationScale" value="true"/>
    <add key="VirtualBackgroundUseOnnxDirectMlExecutionProvider" value="true"/>
    <add key="VideoPreviewWidth" value="640"/>
    <add key="VideoPreviewHeight" value="480"/>
  </appSettings>
  <!--<sipsoftphone>
    <sipsockets>
      <sipsocket>192.168.11.50:7060</sipsocket>
    </sipsockets>
  </sipsoftphone>-->
</configuration>
