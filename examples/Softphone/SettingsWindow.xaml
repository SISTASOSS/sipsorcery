<Window
    x:Class="SIPSorcery.SoftPhone.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Softphone Settings"
    Height="500"
    Width="640"
    MinHeight="420"
    MinWidth="520"
    Loaded="OnLoaded"
    Closed="OnClosed">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Audio Input" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox
                    x:Name="AudioInputDevicesComboBox"
                    MinWidth="200"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Index"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Audio Output" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox
                    x:Name="AudioOutputDevicesComboBox"
                    MinWidth="200"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Index"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,0">
                <TextBlock Text="Video Input" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox
                    x:Name="VideoDevicesComboBox"
                    MinWidth="200"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Name"
                    SelectionChanged="VideoDevicesComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Preview Width" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox
                    x:Name="PreviewWidthTextBox"
                    Width="80"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Left"
                    LostFocus="PreviewDimensionTextBox_LostFocus"/>
                <TextBlock Text="Preview Height" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox
                    x:Name="PreviewHeightTextBox"
                    Width="80"
                    HorizontalAlignment="Left"
                    LostFocus="PreviewDimensionTextBox_LostFocus"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="Virtual Background" Margin="0,0,0,16">
            <StackPanel Margin="8,4,8,8">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ComboBox
                        x:Name="VirtualBackgroundModeComboBox"
                        Grid.Column="1"
                        MinWidth="160"
                        SelectionChanged="VirtualBackgroundModeComboBox_SelectionChanged"/>
                </Grid>

                <Grid x:Name="BackgroundImageRow" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Background image" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBox
                        x:Name="BackgroundImagePathTextBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,8,0"/>
                    <Button
                        x:Name="BrowseBackgroundImageButton"
                        Grid.Column="2"
                        Content="Browse..."
                        Width="90"
                        Click="BrowseBackgroundImageButton_Click"/>
                </Grid>

                <Expander Header="Advanced options" IsExpanded="False">
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Blur radius" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="BlurRadiusTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mask reuse (frames)" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskReuseFrameCountTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Segmentation model" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="SegmentationModelPathTextBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0"/>
                            <Button
                                x:Name="BrowseSegmentationModelButton"
                                Grid.Column="2"
                                Content="Browse..."
                                Width="90"
                                Click="BrowseSegmentationModelButton_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Performance budget (ms)" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="PerformanceBudgetMillisecondsTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fallback frames" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox
                                    x:Name="PerformanceFallbackFrameCountTextBox"
                                    Width="80"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Left"/>
                                <CheckBox
                                    x:Name="EnablePerformanceFallbackCheckBox"
                                    Content="Enable fallback"
                                    VerticalAlignment="Center"
                                    Checked="EnablePerformanceFallbackCheckBox_CheckedChanged"
                                    Unchecked="EnablePerformanceFallbackCheckBox_CheckedChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mask smoothing radius" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskSmoothingRadiusTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mask smoothing iterations" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskSmoothingIterationsTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mask feather" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskFeatherTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foreground clamp" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskForegroundClampTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foreground exponent" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskForegroundExponentTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foreground bias" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="MaskForegroundBiasTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Segmentation scale" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="SegmentationScaleTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Effect scale" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBox
                                x:Name="EffectProcessingScaleTextBox"
                                Grid.Column="1"
                                Width="80"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Adaptive segmentation" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox
                                x:Name="EnableAdaptiveSegmentationScaleCheckBox"
                                Grid.Column="1"
                                Content="Enable adaptive scaling"
                                VerticalAlignment="Center"
                                Checked="EnableAdaptiveSegmentationScaleCheckBox_CheckedChanged"
                                Unchecked="EnableAdaptiveSegmentationScaleCheckBox_CheckedChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DirectML" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox
                                x:Name="UseDirectMlExecutionProviderCheckBox"
                                Grid.Column="1"
                                Content="Use DirectML execution provider"
                                VerticalAlignment="Center"
                                Checked="UseDirectMlExecutionProviderCheckBox_CheckedChanged"
                                Unchecked="UseDirectMlExecutionProviderCheckBox_CheckedChanged"/>
                        </Grid>
                    </UniformGrid>
                </Expander>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="2" BorderBrush="#FF807FC3" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Image x:Name="VideoPreviewImage" Stretch="Uniform"/>
                <TextBlock
                    x:Name="PreviewPlaceholder"
                    Text="Select a video input to preview."
                    Foreground="#AA000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#FF444444"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Width="90" Margin="0,0,8,0" Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" Content="Close" Width="90" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
